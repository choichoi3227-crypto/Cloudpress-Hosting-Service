# 개발용 예시. 실제 값은 `wrangler secret put` 으로만 등록하고 절대 커밋하지 않는다.
CLOUDPRESS_MODE=mock            # mock | live
PAYPAL_CLIENT_ID=               # PayPal 앱(REST) Client ID
PAYPAL_CLIENT_SECRET=           # PayPal 앱 Secret. wrangler secret 으로만 등록
PAYPAL_WEBHOOK_ID=              # PayPal 개발자 대시보드에서 웹훅 등록 후 발급되는 ID(서명 검증에 필요)
PAYPAL_ENV=sandbox              # sandbox | live (운영 전환 시 live)
CLOUDFLARE_API_TOKEN=
SUPABASE_MANAGEMENT_TOKEN=
SECRETS_ENCRYPTION_KEY=
NEON_API_KEY=                   # PostgreSQL(Neon) 프로젝트 생성용. 최소 권한 키 사용
SUPABASE_MANAGEMENT_TOKEN=      # PostgreSQL(Supabase) 프로젝트 생성용(재판매 약관 확인 후)
CLOUDFLARE_ACCOUNT_ID=          # 32자리 계정 ID. 토큰은 최소 권한(Registrar 쓰기, Zone/DNS/설정 편집)으로 분리해 발급
