---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="CloudPress 통합 클라우드 호스팅 플랫폼" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} - CloudPress</title>
  </head>
  <body class="bg-background dark:bg-background-dark text-text dark:text-text-dark min-h-screen flex flex-col font-sans">
    <header class="bg-white dark:bg-slate-900 border-b border-gray-200 dark:border-slate-800 sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 text-2xl font-bold text-primary dark:text-blue-400">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
          </svg>
          CloudPress
        </a>
        <nav class="flex items-center gap-6">
          <a href="/dashboard" class="text-sm font-medium hover:text-primary transition-colors">대시보드</a>
          <a href="/domains" class="text-sm font-medium hover:text-primary transition-colors">도메인</a>
          <a href="/admin" class="text-sm font-medium text-amber-600 dark:text-amber-400 font-semibold hover:underline">관리자</a>
          <a href="/login" class="bg-primary hover:bg-blue-700 text-white text-sm font-medium px-4 py-2 rounded-lg transition-colors">로그인</a>
        </nav>
      </div>
    </header>

    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <slot />
    </main>

    <footer class="bg-white dark:bg-slate-900 border-t border-gray-200 dark:border-slate-800 py-6 text-center text-sm text-gray-500 dark:text-gray-400">
      &copy; 2026 CloudPress Inc. All rights reserved.
    </footer>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
