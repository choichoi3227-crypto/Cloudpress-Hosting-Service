---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="서비스 메시 - CloudPress">
  <div class="space-y-8">
    <div class="flex items-center justify-between">
      <h1 class="text-3xl font-bold text-gray-900 dark:text-white">서비스 메시</h1>
      <div class="flex gap-3">
        <button id="refresh-btn" class="bg-primary hover:bg-blue-700 text-white px-4 py-2 rounded-lg font-medium transition-colors">새로고침</button>
      </div>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      <div class="bg-white dark:bg-slate-900 p-6 rounded-xl border border-gray-200 dark:border-slate-800">
        <p class="text-sm text-gray-500 dark:text-gray-400">등록된 서비스</p>
        <p class="text-3xl font-bold text-primary mt-1" id="services-count">-</p>
      </div>
      <div class="bg-white dark:bg-slate-900 p-6 rounded-xl border border-gray-200 dark:border-slate-800">
        <p class="text-sm text-gray-500 dark:text-gray-400">건강한 엔드포인트</p>
        <p class="text-3xl font-bold text-green-600 dark:text-green-400 mt-1" id="healthy-count">-</p>
      </div>
      <div class="bg-white dark:bg-slate-900 p-6 rounded-xl border border-gray-200 dark:border-slate-800">
        <p class="text-sm text-gray-500 dark:text-gray-400">트래픽 정책</p>
        <p class="text-3xl font-bold text-purple-600 dark:text-purple-400 mt-1" id="policies-count">-</p>
      </div>
    </div>

    <div class="grid gap-6 lg:grid-cols-2">
      <div class="bg-white dark:bg-slate-900 rounded-xl border border-gray-200 dark:border-slate-800">
        <div class="px-6 py-4 border-b border-gray-200 dark:border-slate-800 flex items-center justify-between">
          <h2 class="text-lg font-semibold">서비스 목록</h2>
          <select id="namespace-filter" class="px-3 py-1 border border-gray-300 dark:border-slate-700 rounded-lg bg-white dark:bg-slate-800 text-sm">
            <option value="default">default</option>
          </select>
        </div>
        <div class="p-6" id="services-list">
          <div class="text-center py-12 text-gray-500">불러오는 중...</div>
        </div>
      </div>

      <div class="bg-white dark:bg-slate-900 rounded-xl border border-gray-200 dark:border-slate-800">
        <div class="px-6 py-4 border-b border-gray-200 dark:border-slate-800 flex items-center justify-between">
          <h2 class="text-lg font-semibold">트래픽 정책</h2>
          <button id="add-policy-btn" class="bg-primary hover:bg-blue-700 text-white px-3 py-1 rounded-lg text-sm font-medium transition-colors">+ 정책 추가</button>
        </div>
        <div class="p-6" id="policies-list">
          <div class="text-center py-12 text-gray-500">불러오는 중...</div>
        </div>
      </div>
    </div>

    <div class="bg-white dark:bg-slate-900 rounded-xl border border-gray-200 dark:border-slate-800">
      <div class="px-6 py-4 border-b border-gray-200 dark:border-slate-800">
        <h2 class="text-lg font-semibold">mTLS 인증서</h2>
      </div>
      <div class="p-6" id="certificates-list">
        <div class="text-center py-12 text-gray-500">불러오는 중...</div>
      </div>
    </div>
  </div>

  <script>
    async function loadData() {
      try {
        const [servicesRes, policiesRes, certsRes] = await Promise.all([
          fetch("/api/mesh/services?namespace=default", { credentials: "include" }),
          fetch("/api/mesh/policies", { credentials: "include" }),
          fetch("/api/mesh/certificates", { credentials: "include" })
        ]);
        
        if (servicesRes.ok) {
          const data = await servicesRes.json();
          renderServices(data.services || []);
          document.getElementById("services-count")!.textContent = (data.services || []).length.toString();
          document.getElementById("healthy-count")!.textContent = (data.services || []).reduce((sum, s) => sum + (s.endpointCount || 0), 0).toString();
        }
        
        if (policiesRes.ok) {
          const data = await policiesRes.json();
          renderPolicies(data.policies || []);
          document.getElementById("policies-count")!.textContent = (data.policies || []).length.toString();
        }
        
        if (certsRes.ok) {
          const data = await certsRes.json();
          renderCertificates(data.certificates || []);
        }
      } catch (e) {
        console.error(e);
      }
    }

    function renderServices(services) {
      const container = document.getElementById("services-list");
      if (services.length === 0) {
        container.innerHTML = '<div class="text-center py-12 text-gray-500">등록된 서비스가 없습니다.</div>';
        return;
      }
      container.innerHTML = services.map(s => `
        <div class="p-4 border border-gray-200 dark:border-slate-700 rounded-lg mb-3">
          <div class="flex items-center justify-between">
            <div>
              <p class="font-medium">${s.serviceName}</p>
              <p class="text-sm text-gray-500">${s.namespace} • ${s.endpointCount} 엔드포인트</p>
            </div>
            <span class="px-2 py-1 text-xs font-medium rounded-full ${s.endpointCount > 0 ? "bg-green-100 text-green-800" : "bg-gray-100 text-gray-800"}">
              ${s.endpointCount > 0 ? "건강함" : "엔드포인트 없음"}
            </span>
          </div>
        </div>
      `).join("");
    }

    function renderPolicies(policies) {
      const container = document.getElementById("policies-list");
      if (policies.length === 0) {
        container.innerHTML = '<div class="text-center py-12 text-gray-500">트래픽 정책이 없습니다.</div>';
        return;
      }
      container.innerHTML = policies.map(p => `
        <div class="p-4 border border-gray-200 dark:border-slate-700 rounded-lg mb-3">
          <div class="flex items-center justify-between">
            <div>
              <p class="font-mono text-sm">${p.sourceService} → ${p.targetService}</p>
              <p class="text-sm text-gray-500">${p.namespace} • 우선순위: ${p.priority}</p>
            </div>
            <span class="px-2 py-1 text-xs font-medium rounded-full ${getPolicyColor(p.policy)}">${p.policy}</span>
          </div>
        </div>
      `).join("");
    }

    function getPolicyColor(policy) {
      switch (policy) {
        case "allow": return "bg-green-100 text-green-800";
        case "deny": return "bg-red-100 text-red-800";
        case "rate_limit": return "bg-amber-100 text-amber-800";
        case "circuit_breaker": return "bg-purple-100 text-purple-800";
        default: return "bg-gray-100 text-gray-800";
      }
    }

    function renderCertificates(certs) {
      const container = document.getElementById("certificates-list");
      if (certs.length === 0) {
        container.innerHTML = '<div class="text-center py-12 text-gray-500">발급된 인증서가 없습니다.</div>';
        return;
      }
      container.innerHTML = certs.map(c => `
        <div class="p-4 border border-gray-200 dark:border-slate-700 rounded-lg mb-3">
          <div class="grid gap-4 md:grid-cols-4">
            <div><strong>서비스</strong><p>${c.service_name}</p></div>
            <div><strong>네임스페이스</strong><p>${c.namespace}</p></div>
            <div><strong>발급일</strong><p>${c.issued_at ? new Date(c.issued_at).toLocaleDateString("ko-KR") : "-"}</p></div>
            <div><strong>만료일</strong><p>${c.expires_at ? new Date(c.expires_at).toLocaleDateString("ko-KR") : "-"}</p></div>
          </div>
        </div>
      `).join("");
    }

    document.getElementById("refresh-btn")?.addEventListener("click", loadData);
    document.getElementById("namespace-filter")?.addEventListener("change", () => loadData());
    document.getElementById("add-policy-btn")?.addEventListener("click", () => {
      const source = prompt("소스 서비스:");
      const target = prompt("타겟 서비스:");
      const policy = prompt("정책 (allow/deny/rate_limit/retry/timeout/circuit_breaker):");
      if (source && target && policy) {
        fetch("/api/mesh/policies", {
          method: "POST",
          headers: { "Content-Type": "application/json", "X-CSRF-Token": (window as any).csrfToken },
          credentials: "include",
          body: JSON.stringify({ sourceService: source, targetService: target, namespace: "default", policy, config: {}, priority: 100 })
        }).then(() => loadData());
      }
    });

    loadData();
  </script>
</Layout>
