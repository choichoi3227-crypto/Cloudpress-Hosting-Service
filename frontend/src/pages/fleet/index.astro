---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="플릿 배포 - CloudPress">
  <div class="space-y-8">
    <div class="flex items-center justify-between">
      <h1 class="text-3xl font-bold text-gray-900 dark:text-white">플릿 배포</h1>
      <button id="create-deploy-btn" class="bg-primary hover:bg-blue-700 text-white px-4 py-2 rounded-lg font-medium transition-colors">+ 새 배포</button>
    </div>

    <div class="grid gap-6 md:grid-cols-4">
      <div class="bg-white dark:bg-slate-900 p-6 rounded-xl border border-gray-200 dark:border-slate-800">
        <p class="text-sm text-gray-500 dark:text-gray-400">진행 중</p>
        <p class="text-3xl font-bold text-blue-600 dark:text-blue-400 mt-1" id="running-deploys">-</p>
      </div>
      <div class="bg-white dark:bg-slate-900 p-6 rounded-xl border border-gray-200 dark:border-slate-800">
        <p class="text-sm text-gray-500 dark:text-gray-400">성공 (24h)</p>
        <p class="text-3xl font-bold text-green-600 dark:text-green-400 mt-1" id="success-deploys">-</p>
      </div>
      <div class="bg-white dark:bg-slate-900 p-6 rounded-xl border border-gray-200 dark:border-slate-800">
        <p class="text-sm text-gray-500 dark:text-gray-400">실패 (24h)</p>
        <p class="text-3xl font-bold text-red-600 dark:text-red-400 mt-1" id="failed-deploys">-</p>
      </div>
      <div class="bg-white dark:bg-slate-900 p-6 rounded-xl border border-gray-200 dark:border-slate-800">
        <p class="text-sm text-gray-500 dark:text-gray-400">롤백 발생</p>
        <p class="text-3xl font-bold text-amber-600 dark:text-amber-400 mt-1" id="rollbacks-count">-</p>
      </div>
    </div>

    <div class="bg-white dark:bg-slate-900 rounded-xl border border-gray-200 dark:border-slate-800">
      <div class="px-6 py-4 border-b border-gray-200 dark:border-slate-800 flex items-center justify-between">
        <h2 class="text-lg font-semibold">배포 이력</h2>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead class="bg-gray-50 dark:bg-slate-800/50">
            <tr class="text-left text-sm text-gray-500 dark:text-gray-400">
              <th class="px-6 py-3">이름</th>
              <th class="px-6 py-3">전략</th>
              <th class="px-6 py-3">타겟 버전</th>
              <th class="px-6 py-3">단계</th>
              <th class="px-6 py-3">상태</th>
              <th class="px-6 py-3">시작일</th>
              <th class="px-6 py-3">액션</th>
            </tr>
          </thead>
          <tbody id="deploys-table" class="divide-y divide-gray-200 dark:divide-slate-800">
            <tr><td colspan="7" class="px-6 py-12 text-center text-gray-500">불러오는 중...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script type="module">
    async function loadDeployments() {
      try {
        const res = await fetch("/api/fleet/deployments", { credentials: "include" });
        if (res.ok) {
          const data = await res.json();
          renderDeployments(data.deployments || []);
        }
      } catch (e) {
        console.error(e);
      }
    }

    function renderDeployments(deploys) {
      const tbody = document.getElementById("deploys-table");
      
      document.getElementById("running-deploys")!.textContent = deploys.filter(d => d.status === "running").length.toString();
      document.getElementById("success-deploys")!.textContent = deploys.filter(d => d.status === "succeeded").length.toString();
      document.getElementById("failed-deploys")!.textContent = deploys.filter(d => d.status === "failed").length.toString();
      document.getElementById("rollbacks-count")!.textContent = deploys.filter(d => d.status === "rolled_back").length.toString();

      if (deploys.length === 0) {
        tbody.innerHTML = '<tr><td colspan="7" class="px-6 py-12 text-center text-gray-500">배포 이력이 없습니다.</td></tr>';
        return;
      }

      tbody.innerHTML = deploys.map(d => `
        <tr class="hover:bg-gray-50 dark:hover:bg-slate-800/50">
          <td class="px-6 py-4 font-medium">${d.name}</td>
          <td class="px-6 py-4">
            <span class="px-2 py-1 text-xs font-medium rounded-full ${getStrategyColor(d.strategy?.type)}">${d.strategy?.type || "rolling"}</span>
          </td>
          <td class="px-6 py-4 font-mono text-sm">${d.targetVersion}</td>
          <td class="px-6 py-4 text-sm">${d.currentStep} / ${d.totalSteps}</td>
          <td class="px-6 py-4">
            <span class="px-2 py-1 text-xs font-medium rounded-full ${getStatusColor(d.status)}">${d.status}</span>
          </td>
          <td class="px-6 py-4 text-sm">${d.startedAt ? new Date(d.startedAt).toLocaleString("ko-KR") : "-"}</td>
          <td class="px-6 py-4">
            ${d.status === "running" ? '<button class="action-btn text-amber-600 hover:underline text-sm" data-action="pause" data-id="' + d.id + '">일시정지</button>' : ""}
            ${d.status === "paused" ? '<button class="action-btn text-green-600 hover:underline text-sm" data-action="resume" data-id="' + d.id + '">재개</button>' : ""}
            ${d.status === "succeeded" || d.status === "failed" ? '<button class="action-btn text-red-600 hover:underline text-sm" data-action="rollback" data-id="' + d.id + '">롤백</button>' : ""}
          </td>
        </tr>
      `).join("");

      document.querySelectorAll("#deploys-table .action-btn").forEach(btn => {
        btn.addEventListener("click", (e) => {
          e.stopPropagation();
          const action = btn.dataset.action;
          const id = btn.dataset.id;
          if (action === "pause") pauseDeployment(id);
          else if (action === "resume") resumeDeployment(id);
          else if (action === "rollback") rollbackDeployment(id);
        });
      });
    }

    function getStrategyColor(type) {
      switch (type) {
        case "canary": return "bg-purple-100 text-purple-800";
        case "blue_green": return "bg-blue-100 text-blue-800";
        case "rolling": return "bg-green-100 text-green-800";
        default: return "bg-gray-100 text-gray-800";
      }
    }

    function getStatusColor(status) {
      switch (status) {
        case "succeeded": return "bg-green-100 text-green-800";
        case "running": return "bg-blue-100 text-blue-800";
        case "failed": return "bg-red-100 text-red-800";
        case "rolled_back": return "bg-amber-100 text-amber-800";
        case "paused": return "bg-purple-100 text-purple-800";
        default: return "bg-gray-100 text-gray-800";
      }
    }

    async function pauseDeployment(id) {
      const res = await fetch("/api/fleet/deployments/" + id + "/pause", { method: "POST", headers: { "X-CSRF-Token": (window as any).csrfToken }, credentials: "include" });
      if (res.ok) loadDeployments();
    }

    async function resumeDeployment(id) {
      const res = await fetch("/api/fleet/deployments/" + id + "/resume", { method: "POST", headers: { "X-CSRF-Token": (window as any).csrfToken }, credentials: "include" });
      if (res.ok) loadDeployments();
    }

    async function rollbackDeployment(id) {
      const reason = prompt("롤백 사유:");
      if (reason) {
        const res = await fetch("/api/fleet/deployments/" + id + "/rollback", {
          method: "POST",
          headers: { "Content-Type": "application/json", "X-CSRF-Token": (window as any).csrfToken },
          credentials: "include",
          body: JSON.stringify({ reason })
        });
        if (res.ok) { alert("롤백이 시작되었습니다."); loadDeployments(); }
      }
    }

    document.getElementById("create-deploy-btn")?.addEventListener("click", () => {
      const name = prompt("배포 이름:");
      const version = prompt("타겟 버전 (예: v1.2.0):");
      const strategy = prompt("전략 (rolling/canary/blue_green/recreate):", "rolling");
      if (name && version && strategy) {
        fetch("/api/fleet/deployments", {
          method: "POST",
          headers: { "Content-Type": "application/json", "X-CSRF-Token": (window as any).csrfToken },
          credentials: "include",
          body: JSON.stringify({ name, targetVersion: version, strategy: { type: strategy, maxSurge: 20 } })
        }).then(() => loadDeployments());
      }
    });

    loadDeployments();
  </script>
</Layout>
