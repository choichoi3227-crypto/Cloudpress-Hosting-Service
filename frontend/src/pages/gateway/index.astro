---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="API 게이트웨이 - CloudPress">
  <div class="space-y-8">
    <div class="flex items-center justify-between">
      <h1 class="text-3xl font-bold text-gray-900 dark:text-white">API 게이트웨이</h1>
      <button id="add-route-btn" class="bg-primary hover:bg-blue-700 text-white px-4 py-2 rounded-lg font-medium transition-colors">+ 라우트 추가</button>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      <div class="bg-white dark:bg-slate-900 p-6 rounded-xl border border-gray-200 dark:border-slate-800">
        <p class="text-sm text-gray-500 dark:text-gray-400">등록된 라우트</p>
        <p class="text-3xl font-bold text-primary mt-1" id="routes-count">-</p>
      </div>
      <div class="bg-white dark:bg-slate-900 p-6 rounded-xl border border-gray-200 dark:border-slate-800">
        <p class="text-sm text-gray-500 dark:text-gray-400">활성 변환 규칙</p>
        <p class="text-3xl font-bold text-purple-600 dark:text-purple-400 mt-1" id="transforms-count">-</p>
      </div>
      <div class="bg-white dark:bg-slate-900 p-6 rounded-xl border border-gray-200 dark:border-slate-800">
        <p class="text-sm text-gray-500 dark:text-gray-400">속도 제한 규칙</p>
        <p class="text-3xl font-bold text-amber-600 dark:text-amber-400 mt-1" id="ratelimits-count">-</p>
      </div>
    </div>

    <div class="bg-white dark:bg-slate-900 rounded-xl border border-gray-200 dark:border-slate-800">
      <div class="px-6 py-4 border-b border-gray-200 dark:border-slate-800 flex items-center justify-between">
        <h2 class="text-lg font-semibold">라우트 관리</h2>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead class="bg-gray-50 dark:bg-slate-800/50">
            <tr class="text-left text-sm text-gray-500 dark:text-gray-400">
              <th class="px-6 py-3">이름</th>
              <th class="px-6 py-3">경로 패턴</th>
              <th class="px-6 py-3">메서드</th>
              <th class="px-6 py-3">타겟</th>
              <th class="px-6 py-3">인증</th>
              <th class="px-6 py-3">상태</th>
              <th class="px-6 py-3">액션</th>
            </tr>
          </thead>
          <tbody id="routes-table" class="divide-y divide-gray-200 dark:divide-slate-800">
            <tr><td colspan="7" class="px-6 py-12 text-center text-gray-500">불러오는 중...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script>
    async function loadRoutes() {
      try {
        const res = await fetch("/api/gateway/routes", { credentials: "include" });
        if (res.ok) {
          const data = await res.json();
          renderRoutes(data.routes || []);
        }
      } catch (e) {
        console.error(e);
      }
    }

    function renderRoutes(routes) {
      const tbody = document.getElementById("routes-table");
      document.getElementById("routes-count")!.textContent = routes.length.toString();
      
      if (routes.length === 0) {
        tbody.innerHTML = '<tr><td colspan="7" class="px-6 py-12 text-center text-gray-500">라우트가 없습니다.</td></tr>';
        return;
      }

      tbody.innerHTML = routes.map(r => `
        <tr class="hover:bg-gray-50 dark:hover:bg-slate-800/50">
          <td class="px-6 py-4 font-medium">${r.name}</td>
          <td class="px-6 py-4 font-mono text-sm">${r.path_pattern}</td>
          <td class="px-6 py-4">
            <span class="px-2 py-0.5 text-xs bg-primary/10 text-primary rounded">${r.methods?.join(", ") || "ALL"}</span>
          </td>
          <td class="px-6 py-4 text-sm">${r.target_service || r.target_url || "-"}</td>
          <td class="px-6 py-4">
            <span class="px-2 py-1 text-xs font-medium rounded-full ${r.auth_required ? "bg-green-100 text-green-800" : "bg-gray-100 text-gray-800"}">
              ${r.auth_required ? "필수" : "선택"}
            </span>
          </td>
          <td class="px-6 py-4">
            <span class="px-2 py-1 text-xs font-medium rounded-full bg-green-100 text-green-800">활성</span>
          </td>
          <td class="px-6 py-4">
            <button class="action-btn text-primary hover:underline text-sm" data-action="edit" data-id="${r.id}">편집</button>
            <button class="action-btn text-red-600 hover:underline text-sm ml-2" data-action="delete" data-id="${r.id}">삭제</button>
          </td>
        </tr>
      `).join("");
    }

    document.getElementById("add-route-btn")?.addEventListener("click", () => {
      const name = prompt("라우트 이름:");
      const path = prompt("경로 패턴 (예: /api/v1/*):");
      const target = prompt("타겟 서비스 (예: my-service) 또는 URL:");
      if (name && path && target) {
        fetch("/api/gateway/routes", {
          method: "POST",
          headers: { "Content-Type": "application/json", "X-CSRF-Token": (window as any).csrfToken },
          credentials: "include",
          body: JSON.stringify({ name, pathPattern: path, methods: ["GET","POST","PUT","DELETE"], targetService: target.startsWith("http") ? undefined : target, targetUrl: target.startsWith("http") ? target : undefined, stripPathPrefix: true, timeoutMs: 30000, retries: 3, retryBackoffMs: 100, circuitBreakerThreshold: 5, circuitBreakerTimeoutSec: 30, authRequired: true })
        }).then(() => loadRoutes());
      }
    });

    loadRoutes();
  </script>
</Layout>
