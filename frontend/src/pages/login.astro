---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="로그인 - CloudPress">
  <div class="max-w-md mx-auto my-12 bg-white dark:bg-slate-900 p-8 rounded-xl border border-gray-200 dark:border-slate-800 shadow-sm">
    <div class="text-center mb-6">
      <h1 class="text-2xl font-bold text-gray-900 dark:text-white">CloudPress 로그인</h1>
      <p class="text-gray-500 text-sm mt-1">계정에 로그인하세요</p>
    </div>

    <form id="login-form" class="space-y-4">
      <div>
        <label for="email" class="block text-sm font-medium mb-1">이메일</label>
        <input type="email" id="email" name="email" required class="w-full px-4 py-2 border rounded-lg dark:bg-slate-800 dark:border-slate-700 focus:ring-2 focus:ring-primary outline-none" />
      </div>

      <div>
        <label for="password" class="block text-sm font-medium mb-1">비밀번호</label>
        <input type="password" id="password" name="password" required class="w-full px-4 py-2 border rounded-lg dark:bg-slate-800 dark:border-slate-700 focus:ring-2 focus:ring-primary outline-none" />
      </div>

      <div id="error-message" class="hidden text-red-600 text-sm py-2"></div>

      <button type="submit" class="w-full bg-primary hover:bg-blue-700 text-white font-medium py-2.5 rounded-lg transition-colors">
        로그인
      </button>
    </form>

    <div class="mt-6 text-center text-sm text-gray-500">
      계정이 없으신가요? <a href="/register" class="text-primary hover:underline">회원가입</a>
    </div>
  </div>

  <script>
    import '@/scripts/login.ts';
  </script>
</Layout>
