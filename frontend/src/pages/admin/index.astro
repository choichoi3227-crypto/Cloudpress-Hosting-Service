---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="관리자 대시보드 - CloudPress">
  <div class="space-y-8">
    <div class="flex items-center justify-between">
      <h1 class="text-3xl font-bold text-gray-900 dark:text-white">관리자 대시보드</h1>
      <span class="px-3 py-1 bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-400 rounded-full text-sm font-medium">관리자 모드</span>
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4" id="admin-stats">
      <div class="bg-white dark:bg-slate-900 p-6 rounded-xl border border-gray-200 dark:border-slate-800">
        <p class="text-sm text-gray-500 dark:text-gray-400">전체 사용자</p>
        <p class="text-3xl font-bold text-gray-900 dark:text-white mt-1" id="total-users">-</p>
      </div>
      <div class="bg-white dark:bg-slate-900 p-6 rounded-xl border border-gray-200 dark:border-slate-800">
        <p class="text-sm text-gray-500 dark:text-gray-400">활성 구독</p>
        <p class="text-3xl font-bold text-gray-900 dark:text-white mt-1" id="active-subs">-</p>
      </div>
      <div class="bg-white dark:bg-slate-900 p-6 rounded-xl border border-gray-200 dark:border-slate-800">
        <p class="text-sm text-gray-500 dark:text-gray-400">월 매출</p>
        <p class="text-3xl font-bold text-gray-900 dark:text-white mt-1" id="monthly-revenue">-</p>
      </div>
      <div class="bg-white dark:bg-slate-900 p-6 rounded-xl border border-gray-200 dark:border-slate-800">
        <p class="text-sm text-gray-500 dark:text-gray-400">시스템 상태</p>
        <div class="flex items-center gap-2 mt-1">
          <span class="w-3 h-3 rounded-full" id="health-indicator"></span>
          <span class="font-semibold" id="health-text">확인 중...</span>
        </div>
      </div>
    </div>

    <div class="grid gap-6 lg:grid-cols-2">
      <div class="bg-white dark:bg-slate-900 rounded-xl border border-gray-200 dark:border-slate-800 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200 dark:border-slate-800 flex items-center justify-between">
          <h2 class="text-lg font-semibold">낭비 리소스 감지</h2>
          <span class="px-2 py-1 text-xs font-medium rounded-full bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-400" id="waste-count">0건</span>
        </div>
        <div class="p-6" id="waste-list">
          <div class="text-center py-12 text-gray-500">분석 중...</div>
        </div>
      </div>

      <div class="bg-white dark:bg-slate-900 rounded-xl border border-gray-200 dark:border-slate-800 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200 dark:border-slate-800 flex items-center justify-between">
          <h2 class="text-lg font-semibold">승인 대기 작업</h2>
          <span class="px-2 py-1 text-xs font-medium rounded-full bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-400" id="pending-count">0건</span>
        </div>
        <div class="p-6" id="pending-list">
          <div class="text-center py-12 text-gray-500">로딩 중...</div>
        </div>
      </div>
    </div>

    <div class="bg-white dark:bg-slate-900 rounded-xl border border-gray-200 dark:border-slate-800 overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200 dark:border-slate-800">
        <h2 class="text-lg font-semibold">환율 관리 (KRW/USD)</h2>
      </div>
      <div class="p-6">
        <div class="flex flex-col sm:flex-row gap-4 items-end max-w-md">
          <div class="flex-1">
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">원/달러 환율</label>
            <input type="number" id="fx-rate-input" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary" placeholder="1400" min="1000" max="2000" step="1" />
          </div>
          <button id="fx-rate-btn" class="bg-primary hover:bg-blue-700 text-white px-6 py-2.5 rounded-lg font-medium transition-colors whitespace-nowrap">적용</button>
        </div>
        <p class="mt-3 text-sm text-gray-500 dark:text-gray-400">현재 적용 환율: <span id="current-fx" class="font-medium">로딩 중...</span>원</p>
      </div>
    </div>
  </div>

  <script>
    import { loadAdminDashboard, initFxRateHandler } from '../../scripts/admin-dashboard.ts';
    loadAdminDashboard();
    initFxRateHandler();
  </script>
</Layout>
