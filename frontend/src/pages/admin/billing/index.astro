---
import Layout from "../../../layouts/Layout.astro";
---

<Layout title="관리자 - 청구 관리 - CloudPress">
  <div class="space-y-8">
    <div class="flex items-center justify-between">
      <h1 class="text-3xl font-bold text-gray-900 dark:text-white">청구 관리</h1>
      <a href="/admin" class="text-primary hover:underline">← 관리자 대시보드</a>
    </div>

    <div class="grid gap-6 md:grid-cols-4 mb-8">
      <div class="bg-white dark:bg-slate-900 p-6 rounded-xl border border-gray-200 dark:border-slate-800">
        <p class="text-sm text-gray-500 dark:text-gray-400">이번 달 매출</p>
        <p class="text-3xl font-bold text-green-600 dark:text-green-400 mt-1" id="monthly-revenue">-</p>
      </div>
      <div class="bg-white dark:bg-slate-900 p-6 rounded-xl border border-gray-200 dark:border-slate-800">
        <p class="text-sm text-gray-500 dark:text-gray-400">미수금</p>
        <p class="text-3xl font-bold text-amber-600 dark:text-amber-400 mt-1" id="outstanding">-</p>
      </div>
      <div class="bg-white dark:bg-slate-900 p-6 rounded-xl border border-gray-200 dark:border-slate-800">
        <p class="text-sm text-gray-500 dark:text-gray-400">환불 건수</p>
        <p class="text-3xl font-bold text-red-600 dark:text-red-400 mt-1" id="refunds-count">-</p>
      </div>
      <div class="bg-white dark:bg-slate-900 p-6 rounded-xl border border-gray-200 dark:border-slate-800">
        <p class="text-sm text-gray-500 dark:text-gray-400">활성 구독</p>
        <p class="text-3xl font-bold text-primary mt-1" id="active-subs">-</p>
      </div>
    </div>

    <div class="bg-white dark:bg-slate-900 rounded-xl border border-gray-200 dark:border-slate-800">
      <div class="px-6 py-4 border-b border-gray-200 dark:border-slate-800 flex items-center justify-between">
        <h2 class="text-lg font-semibold">최근 청구서</h2>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead class="bg-gray-50 dark:bg-slate-800/50">
            <tr class="text-left text-sm text-gray-500 dark:text-gray-400">
              <th class="px-6 py-3">청구서 ID</th>
              <th class="px-6 py-3">고객</th>
              <th class="px-6 py-3">금액</th>
              <th class="px-6 py-3">상태</th>
              <th class="px-6 py-3">발행일</th>
              <th class="px-6 py-3">결제일</th>
              <th class="px-6 py-3">액션</th>
            </tr>
          </thead>
          <tbody id="invoices-table" class="divide-y divide-gray-200 dark:divide-slate-800">
            <tr><td colspan="7" class="px-6 py-12 text-center text-gray-500">불러오는 중...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script type="module">
    async function loadBilling() {
      try {
        const res = await fetch("/api/admin/billing", { credentials: "include" });
        if (res.ok) {
          const data = await res.json();
          renderBilling(data);
        }
      } catch (e) {
        console.error(e);
      }
    }

    function renderBilling(data) {
      document.getElementById("monthly-revenue")!.textContent = "₩" + (data.monthlyRevenue / 1000000).toLocaleString();
      document.getElementById("outstanding")!.textContent = "₩" + (data.outstanding / 1000000).toLocaleString();
      document.getElementById("refunds-count")!.textContent = data.refundsCount.toString();
      document.getElementById("active-subs")!.textContent = data.activeSubscriptions.toString();

      const tbody = document.getElementById("invoices-table");
      if ((data.invoices || []).length === 0) {
        tbody.innerHTML = '<tr><td colspan="7" class="px-6 py-12 text-center text-gray-500">청구서가 없습니다.</td></tr>';
        return;
      }
      tbody.innerHTML = (data.invoices || []).map(inv => `
        <tr class="hover:bg-gray-50 dark:hover:bg-slate-800/50">
          <td class="px-6 py-4 font-mono text-sm">${inv.id.slice(0,12)}...</td>
          <td class="px-6 py-4">${inv.customer_email}</td>
          <td class="px-6 py-4">₩${(inv.total_micro / 1000000).toLocaleString()}</td>
          <td class="px-6 py-4">
            <span class="px-2 py-1 text-xs font-medium rounded-full ${inv.status === "paid" ? "bg-green-100 text-green-800" : inv.status === "open" ? "bg-blue-100 text-blue-800" : "bg-gray-100 text-gray-800"}">${inv.status}</span>
          </td>
          <td class="px-6 py-4">${new Date(inv.created_at).toLocaleDateString("ko-KR")}</td>
          <td class="px-6 py-4">${inv.paid_at ? new Date(inv.paid_at).toLocaleDateString("ko-KR") : "-"}</td>
          <td class="px-6 py-4">
            <button class="action-btn text-primary hover:underline text-sm" data-action="view" data-id="${inv.id}">상세</button>
            ${inv.status === "open" ? '<button class="action-btn text-red-600 hover:underline text-sm ml-2" data-action="void" data-id="' + inv.id + '">무효화</button>' : ""}
          </td>
        </tr>
      `).join("");
    }

    loadBilling();
  </script>
</Layout>
