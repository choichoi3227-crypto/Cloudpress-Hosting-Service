---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="새 서비스 생성 - CloudPress">
  <div class="space-y-8 max-w-4xl">
    <div class="flex items-center justify-between">
      <h1 class="text-3xl font-bold text-gray-900 dark:text-white">새 서비스 생성</h1>
      <a href="/services" class="text-primary hover:underline">← 서비스 목록</a>
    </div>

    <form id="create-service-form" class="bg-white dark:bg-slate-900 rounded-xl border border-gray-200 dark:border-slate-800 p-6 space-y-6">
      <div class="grid gap-6 md:grid-cols-2">
        <div>
          <label for="product-kind" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">서비스 유형</label>
          <select id="product-kind" class="w-full px-4 py-2 border border-gray-300 dark:border-slate-700 rounded-lg bg-white dark:bg-slate-800 text-gray-900 dark:text-white"></select>
        </div>
        <div>
          <label for="product-id" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">상품</label>
          <select name="productId" id="product-id" required class="w-full px-4 py-2 border border-gray-300 dark:border-slate-700 rounded-lg bg-white dark:bg-slate-800 text-gray-900 dark:text-white"></select>
        </div>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        <div>
          <p class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">결제 수단 / 통화</p>
          <p class="px-4 py-2 text-gray-700 dark:text-gray-300">PayPal · USD</p>
          <input type="hidden" id="currency" value="USD" />
        </div>
        <div>
          <p class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">구독 주기</p>
          <p class="px-4 py-2 text-gray-700 dark:text-gray-300">월간 결제 (서비스별 독립 구독)</p>
        </div>
      </div>

      <div class="bg-gray-50 dark:bg-slate-800/50 p-4 rounded-lg border border-gray-200 dark:border-slate-700">
        <h3 class="font-medium mb-2">월 요금</h3>
        <div id="price-preview" class="text-2xl font-bold text-primary">-</div>
        <p class="text-sm text-gray-500 dark:text-gray-400 mt-1" id="price-detail">상품을 선택하세요.</p>
      </div>

      <p id="create-error" class="hidden text-sm text-red-600"></p>

      <div class="flex gap-3 pt-4 border-t border-gray-200 dark:border-slate-800">
        <button type="submit" id="create-btn" class="bg-primary hover:bg-blue-700 text-white px-6 py-3 rounded-lg font-medium transition-colors flex-1">
          PayPal로 결제하고 서비스 생성
        </button>
        <a href="/services" class="bg-gray-100 hover:bg-gray-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-gray-700 dark:text-gray-300 px-6 py-3 rounded-lg font-medium transition-colors flex-1 text-center">
          취소
        </a>
      </div>
    </form>
  </div>

  <script>
    interface Plan { id: string; kind: string; nameKo: string; monthlyMicro: number; instanceType: string | null; targetVcpu: number | null; includedStorageGb: number | null }
    const kindNames: Record<string, string> = {
      ccs: "CCS 컨테이너", cloudb: "ClouDB (MariaDB/MySQL)", cloudb_sqlite: "ClouDB SQLite", cloudb_pg: "ClouDB PostgreSQL",
      cloudage: "Cloudage 스토리지", csw: "CSW 서버리스", wordpress: "WordPress 호스팅", cas: "CAS AI 모델"
    };
    let plans: Plan[] = [];
    const kindSel = document.getElementById("product-kind") as HTMLSelectElement;
    const prodSel = document.getElementById("product-id") as HTMLSelectElement;
    const usd = (micro: number) => "$" + (micro / 1_000_000).toFixed(2);

    function fillProducts() {
      const list = plans.filter(p => p.kind === kindSel.value);
      prodSel.innerHTML = list.map(p => `<option value="${p.id}">${p.nameKo} — ${usd(p.monthlyMicro)}/월</option>`).join("");
      updatePrice();
    }
    function updatePrice() {
      const p = plans.find(x => x.id === prodSel.value);
      const priceEl = document.getElementById("price-preview")!;
      const detailEl = document.getElementById("price-detail")!;
      if (!p) { priceEl.textContent = "-"; detailEl.textContent = "판매 중인 상품이 없습니다."; return; }
      priceEl.textContent = usd(p.monthlyMicro) + "/월";
      const spec = [p.instanceType ? "인스턴스 " + p.instanceType : "", p.targetVcpu ? "vCPU 목표 " + p.targetVcpu : "", p.includedStorageGb ? "저장 " + p.includedStorageGb + "GB 포함" : ""].filter(Boolean).join(" · ");
      detailEl.textContent = spec || "월 기본 요금";
    }
    async function loadPlans() {
      const res = await fetch("/api/plans", { credentials: "include" });
      if (!res.ok) { document.getElementById("price-detail")!.textContent = "상품 목록을 불러오지 못했습니다."; return; }
      plans = await res.json();
      const kinds = [...new Set(plans.map(p => p.kind))];
      kindSel.innerHTML = kinds.map(k => `<option value="${k}">${kindNames[k] || k}</option>`).join("");
      fillProducts();
    }
    kindSel.addEventListener("change", fillProducts);
    prodSel.addEventListener("change", updatePrice);

    document.getElementById("create-service-form")?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const err = document.getElementById("create-error")!;
      const btn = document.getElementById("create-btn") as HTMLButtonElement;
      err.classList.add("hidden");
      btn.disabled = true; btn.textContent = "PayPal로 이동 중...";
      try {
        const res = await fetch("/api/subscriptions", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          credentials: "include",
          body: JSON.stringify({ productId: prodSel.value, currency: "USD" })
        });
        const data = await res.json();
        if (res.ok && data.url) { window.location.href = data.url; return; }
        err.textContent = "생성 실패: " + (data.message || data.error || res.status);
        err.classList.remove("hidden");
      } catch {
        err.textContent = "네트워크 오류가 발생했습니다.";
        err.classList.remove("hidden");
      }
      btn.disabled = false; btn.textContent = "PayPal로 결제하고 서비스 생성";
    });

    loadPlans();
  </script>
</Layout>
