---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="새 서비스 생성 - CloudPress">
  <div class="space-y-8 max-w-4xl">
    <div class="flex items-center justify-between">
      <h1 class="text-3xl font-bold text-gray-900 dark:text-white">새 서비스 생성</h1>
      <a href="/dashboard/services" class="text-primary hover:underline">← 서비스 목록</a>
    </div>

    <form id="create-service-form" class="bg-white dark:bg-slate-900 rounded-xl border border-gray-200 dark:border-slate-800 p-6 space-y-6">
      <div class="grid gap-6 md:grid-cols-2">
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">서비스 유형</label>
          <select name="productKind" id="product-kind" class="w-full px-4 py-2 border border-gray-300 dark:border-slate-700 rounded-lg bg-white dark:bg-slate-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary focus:border-transparent">
            <option value="ccs">CCS (CloudPress Compute Service)</option>
            <option value="cloudb">CloudB (Managed MariaDB)</option>
            <option value="cloudage">CloudAge (Container Platform)</option>
            <option value="csw">CSW (Static Web Hosting)</option>
            <option value="wordpress">WordPress Hosting</option>
            <option value="cas">CAS (AI Model Serving)</option>
            <option value="supabase_pg">Supabase PostgreSQL</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">인스턴스 타입</label>
          <select name="instanceType" id="instance-type" class="w-full px-4 py-2 border border-gray-300 dark:border-slate-700 rounded-lg bg-white dark:bg-slate-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary focus:border-transparent">
            <option value="lite">Lite (0.5 vCPU, 1 GB RAM)</option>
            <option value="basic">Basic (1 vCPU, 2 GB RAM)</option>
            <option value="standard-1">Standard-1 (2 vCPU, 4 GB RAM)</option>
            <option value="standard-2">Standard-2 (4 vCPU, 8 GB RAM)</option>
            <option value="standard-3">Standard-3 (8 vCPU, 16 GB RAM)</option>
            <option value="standard-4">Standard-4 (16 vCPU, 32 GB RAM)</option>
          </select>
        </div>
      </div>

      <div class="grid gap-6 md:grid-cols-2">
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">구독 주기</label>
          <select name="billingInterval" class="w-full px-4 py-2 border border-gray-300 dark:border-slate-700 rounded-lg bg-white dark:bg-slate-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary focus:border-transparent">
            <option value="month">월간 결제</option>
            <option value="year">연간 결제 (20% 할인)</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">수량</label>
          <input type="number" name="quantity" value="1" min="1" max="100" class="w-full px-4 py-2 border border-gray-300 dark:border-slate-700 rounded-lg bg-white dark:bg-slate-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary focus:border-transparent">
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">서비스 이름 (선택)</label>
        <input type="text" name="serviceName" placeholder="예: production-web, staging-api" class="w-full px-4 py-2 border border-gray-300 dark:border-slate-700 rounded-lg bg-white dark:bg-slate-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary focus:border-transparent">
      </div>

      <div class="bg-gray-50 dark:bg-slate-800/50 p-4 rounded-lg border border-gray-200 dark:border-slate-700">
        <h3 class="font-medium mb-2">예상 월 요금</h3>
        <div id="price-preview" class="text-2xl font-bold text-primary">0/월</div>
        <p class="text-sm text-gray-500 dark:text-gray-400 mt-1" id="price-detail">옵션을 선택하면 예상 요금이 표시됩니다.</p>
      </div>

      <div class="flex gap-3 pt-4 border-t border-gray-200 dark:border-slate-800">
        <button type="submit" class="bg-primary hover:bg-blue-700 text-white px-6 py-3 rounded-lg font-medium transition-colors flex-1">
          서비스 생성하기
        </button>
        <a href="/dashboard/services" class="bg-gray-100 hover:bg-gray-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-gray-700 dark:text-gray-300 px-6 py-3 rounded-lg font-medium transition-colors flex-1 text-center">
          취소
        </a>
      </div>
    </form>
  </div>

  <script>
    const prices = {
      ccs: { lite: 500000, basic: 1500000, "standard-1": 3000000, "standard-2": 6000000, "standard-3": 12000000, "standard-4": 24000000 },
      cloudb: { basic: 2000000, "standard-1": 4000000, "standard-2": 8000000, "standard-3": 16000000, "standard-4": 32000000 },
      cloudage: { lite: 800000, basic: 2000000, "standard-1": 4000000, "standard-2": 8000000, "standard-3": 16000000, "standard-4": 32000000 },
      csw: { lite: 100000, basic: 300000, "standard-1": 500000 },
      wordpress: { lite: 1500000, basic: 3000000, "standard-1": 6000000, "standard-2": 12000000 },
      cas: { "standard-1": 10000000, "standard-2": 20000000, "standard-3": 40000000 },
      supabase_pg: { basic: 2500000, "standard-1": 5000000, "standard-2": 10000000 }
    };

    const kindNames = {
      ccs: "CCS",
      cloudb: "CloudB",
      cloudage: "CloudAge",
      csw: "CSW",
      wordpress: "WordPress",
      cas: "CAS",
      supabase_pg: "Supabase PostgreSQL"
    };

    function updatePrice() {
      const kindSelect = document.getElementById("product-kind");
      const typeSelect = document.getElementById("instance-type");
      const intervalSelect = document.querySelector("select[name=billingInterval]");
      const quantityInput = document.querySelector("input[name=quantity]");

      if (!kindSelect || !typeSelect || !intervalSelect || !quantityInput) return;

      const kind = kindSelect.value;
      const type = typeSelect.value;
      const interval = intervalSelect.value;
      const quantity = parseInt(quantityInput.value) || 1;

      let monthlyMicro = (prices[kind] && prices[kind][type]) || 0;
      if (interval === "year") {
        monthlyMicro = Math.floor(monthlyMicro * 0.8);
      }
      const totalMicro = monthlyMicro * quantity;

      const priceEl = document.getElementById("price-preview");
      const detailEl = document.getElementById("price-detail");

      if (priceEl) {
        priceEl.textContent = (totalMicro / 1000000).toLocaleString() + (interval === "month" ? "/월" : "/월 (연간 선결제 시)");
      }
      if (detailEl) {
        detailEl.textContent = (kindNames[kind] || kind) + " · " + type + " · " + quantity + "개 · " + (interval === "month" ? "월간" : "연간") + " 결제";
      }
    }

    document.querySelectorAll("#create-service-form select, #create-service-form input").forEach(el => {
      el.addEventListener("change", updatePrice);
      el.addEventListener("input", updatePrice);
    });

    const formEl = document.getElementById("create-service-form");
    if (formEl) {
      formEl.addEventListener("submit", async (e) => {
        e.preventDefault();
        const formData = new FormData(formEl);
        const data = Object.fromEntries(formData.entries());

        try {
          const res = await fetch("/api/subscriptions", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "X-CSRF-Token": window.csrfToken || ""
            },
            credentials: "include",
            body: JSON.stringify(data)
          });

          if (res.ok) {
            window.location.href = "/dashboard/services";
          } else {
            const err = await res.json();
            alert("생성 실패: " + (err.message || err.error));
          }
        } catch {
          alert("네트워크 오류가 발생했습니다.");
        }
      });
    }

    updatePrice();
  </script>
</Layout>
