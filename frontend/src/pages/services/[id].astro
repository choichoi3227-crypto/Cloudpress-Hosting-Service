---
import Layout from '@/layouts/Layout.astro';

export async function getStaticPaths() {
  return [
    { params: { id: '_' } },
  ];
}

const { id } = Astro.params;
---

<Layout title="서비스 상세 - CloudPress">
  <div class="space-y-8" data-service-id={id}>
    <div class="flex items-center justify-between">
      <div>
        <a href="/services" class="text-primary hover:underline text-sm mb-2 inline-block">← 내 서비스</a>
        <h1 class="text-3xl font-bold text-gray-900 dark:text-white" id="service-name">서비스 상세</h1>
      </div>
      <div class="flex gap-3">
        <button id="suspend-btn" class="hidden bg-amber-600 hover:bg-amber-700 text-white px-4 py-2 rounded-lg font-medium transition-colors">일시정지</button>
        <button id="resume-btn" class="hidden bg-primary hover:bg-blue-700 text-white px-4 py-2 rounded-lg font-medium transition-colors">재개</button>
        <button id="cancel-btn" class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-lg font-medium transition-colors">취소</button>
      </div>
    </div>

    <div class="grid gap-6 lg:grid-cols-3">
      <div class="lg:col-span-2 space-y-6">
        <div class="bg-white dark:bg-slate-900 rounded-xl border border-gray-200 dark:border-slate-800 overflow-hidden">
          <div class="px-6 py-4 border-b border-gray-200 dark:border-slate-800">
            <h2 class="text-lg font-semibold">서비스 정보</h2>
          </div>
          <div class="p-6 space-y-4" id="service-info">
            <div class="flex items-center justify-between py-2 border-b border-gray-100 dark:border-slate-800">
              <span class="text-gray-500">상태</span>
              <span class="font-medium" id="info-status">로딩 중...</span>
            </div>
            <div class="flex items-center justify-between py-2 border-b border-gray-100 dark:border-slate-800">
              <span class="text-gray-500">생성일</span>
              <span class="font-medium" id="info-created">-</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // 외부 .ts 파일 임포트로 인한 MIME 타입 에러를 방지하기 위해 클라이언트 로직을 직접 인라인으로 처리
    const wrapper = document.querySelector('[data-service-id]');
    const serviceId = wrapper?.getAttribute('data-service-id');
    
    const nameEl = document.getElementById('service-name');
    const statusEl = document.getElementById('info-status');
    const createdEl = document.getElementById('info-created');
    const cancelBtn = document.getElementById('cancel-btn');

    async function fetchServiceDetail() {
      if (!serviceId || serviceId === '_') return;
      try {
        const res = await fetch(`/api/services/${serviceId}`);
        if (res.ok) {
          const data = await res.json();
          if (nameEl) nameEl.textContent = data.name || '서비스 상세';
          if (statusEl) statusEl.textContent = data.status || '-';
          if (createdEl) createdEl.textContent = data.createdAt ? new Date(data.createdAt).toLocaleDateString() : '-';
        } else {
          if (statusEl) statusEl.textContent = '정보를 불러오지 못했습니다.';
        }
      } catch (err) {
        if (statusEl) statusEl.textContent = '오류가 발생했습니다.';
      }
    }

    cancelBtn?.addEventListener('click', async () => {
      if (!confirm('정말 이 서비스를 취소/삭제하시겠습니까?')) return;
      try {
        const res = await fetch(`/api/services/${serviceId}`, { method: 'DELETE' });
        if (res.ok) {
          window.location.href = '/services';
        } else {
          alert('작업 처리에 실패했습니다.');
        }
      } catch (e) {
        alert('서버 통신 중 오류가 발생했습니다.');
      }
    });

    fetchServiceDetail();
  </script>
</Layout>
