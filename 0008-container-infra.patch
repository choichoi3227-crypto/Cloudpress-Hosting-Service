+export interface ContainerImage {
+  id: string;
+  docker_image: string;
+  instance_type: InstanceType;
+  vcpu: number;
+  memory_mib: number;
+  disk_gb: number;
+  entrypoint: string;
+  env_json: string;
+  labels_json: string;
+  scheduling_policy: "default" | "durable_object";
+  supports_snapshot: number;
+  is_default: number;
+  active: number;
+}
