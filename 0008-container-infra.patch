+-- CloudPress 컨테이너·백업·스냅샷 스키마 (0007)
+-- 0001~0006 적용 후 순차 적용
+
+PRAGMA foreign_keys = ON;
+
+-- 컨테이너 인스턴스 이미지(버전 관리)
+CREATE TABLE container_images (
+  id TEXT PRIMARY KEY,
+  docker_image TEXT NOT NULL,
+  instance_type TEXT NOT NULL CHECK (instance_type IN ('lite','basic','standard-1','standard-2','standard-3','standard-4','custom')),
+  vcpu REAL NOT NULL,
+  memory_mib INTEGER NOT NULL,
+  disk_gb INTEGER NOT NULL,
+  entrypoint TEXT NOT NULL DEFAULT '/entrypoint.sh',
+  env_json TEXT NOT NULL DEFAULT '{}',
+  labels_json TEXT NOT NULL DEFAULT '{}',
+  scheduling_policy TEXT NOT NULL DEFAULT 'durable_object' CHECK (scheduling_policy IN ('default','durable_object')),
+  supports_snapshot INTEGER NOT NULL DEFAULT 1 CHECK (supports_snapshot IN (0,1)),
+  is_default INTEGER NOT NULL DEFAULT 0 CHECK (is_default IN (0,1)),
+  active INTEGER NOT NULL DEFAULT 1 CHECK (active IN (0,1)),
+  created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ','now')),
+  deprecated_at TEXT
+);
+CREATE INDEX idx_images_type_policy ON container_images(instance_type, scheduling_policy, active);
+
+-- 컨테이너 실행 인스턴스 상세(Worker <-> Container 통신용)
+CREATE TABLE container_instances (
+  id TEXT PRIMARY KEY,
+  container_id TEXT NOT NULL REFERENCES containers(id) ON DELETE CASCADE,
+  image_id TEXT NOT NULL REFERENCES container_images(id),
+  cf_instance_id TEXT,
+  scheduling_policy TEXT NOT NULL CHECK (scheduling_policy IN ('default','durable_object')),
+  state TEXT NOT NULL DEFAULT 'starting' CHECK (state IN ('starting','running','sleeping','stopping','stopped','failed')),
+  ip TEXT,
+  port INTEGER,
+  enable_internet INTEGER NOT NULL DEFAULT 0 CHECK (enable_internet IN (0,1)),
+  intercept_targets_json TEXT NOT NULL DEFAULT '[]',
+  labels_json TEXT NOT NULL DEFAULT '{}',
+  last_heartbeat_at TEXT,
+  started_at TEXT,
+  stopped_at TEXT,
+  exit_code INTEGER,
+  exit_reason TEXT,
+  created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ','now')),
+  UNIQUE (container_id, cf_instance_id)
+);
+CREATE INDEX idx_instances_container ON container_instances(container_id, state);
+
+-- 백업 작업(청크 단위 AEAD 암호화 R2 업로드)
+CREATE TABLE backup_jobs (
+  id TEXT PRIMARY KEY,
+  container_id TEXT NOT NULL REFERENCES containers(id) ON DELETE CASCADE,
+  database_id TEXT REFERENCES databases(id) ON DELETE SET NULL,
+  kind TEXT NOT NULL CHECK (kind IN ('full','incremental','binlog')),
+  status TEXT NOT NULL DEFAULT 'pending' CHECK (status IN ('pending','running','completed','failed','cancelled')),
+  r2_prefix TEXT NOT NULL,
+  chunks_total INTEGER NOT NULL DEFAULT 0,
+  chunks_uploaded INTEGER NOT NULL DEFAULT 0,
+  total_bytes INTEGER NOT NULL DEFAULT 0,
+  sha256_manifest TEXT,
+  encryption_key_id TEXT NOT NULL,
+  error TEXT,
+  started_at TEXT,
+  completed_at TEXT,
+  created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ','now')),
+  idempotency_key TEXT NOT NULL UNIQUE
+);
+CREATE INDEX idx_backup_jobs_container ON backup_jobs(container_id, created_at);
+CREATE INDEX idx_backup_jobs_db ON backup_jobs(database_id, created_at);
+
+-- 백업 청크(개별 암호화 파일)
+CREATE TABLE backup_chunks (
+  id TEXT PRIMARY KEY,
+  backup_job_id TEXT NOT NULL REFERENCES backup_jobs(id) ON DELETE CASCADE,
+  chunk_index INTEGER NOT NULL,
+  r2_key TEXT NOT NULL UNIQUE,
+  size_bytes INTEGER NOT NULL,
+  sha256 TEXT NOT NULL,
+  encrypted INTEGER NOT NULL DEFAULT 1 CHECK (encrypted = 1),
+  uploaded_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ','now')),
+  UNIQUE (backup_job_id, chunk_index)
+);
+CREATE INDEX idx_chunks_job ON backup_chunks(backup_job_id);
+
+-- 스냅샷(빠른 복구용, 30일 TTL, 이미지 변경 시 무효)
+CREATE TABLE snapshots (
+  id TEXT PRIMARY KEY,
+  container_id TEXT NOT NULL REFERENCES containers(id) ON DELETE CASCADE,
+  image_id TEXT NOT NULL REFERENCES container_images(id),
+  cf_snapshot_handle TEXT NOT NULL,
+  size_bytes INTEGER,
+  state TEXT NOT NULL DEFAULT 'creating' CHECK (state IN ('creating','ready','expired','invalid','restoring','deleted')),
+  expires_at TEXT NOT NULL,
+  created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ','now')),
+  restored_at TEXT,
+  UNIQUE (container_id, cf_snapshot_handle)
+);
+CREATE INDEX idx_snapshots_container ON snapshots(container_id, state, expires_at);
+
+-- 컨테이너 작업 큐 확장(프로비저닝/백업/스냅샷/복원)
+CREATE TABLE container_jobs (
+  id TEXT PRIMARY KEY,
+  container_id TEXT NOT NULL REFERENCES containers(id) ON DELETE CASCADE,
+  kind TEXT NOT NULL CHECK (kind IN ('provision','start','stop','restart','resize','backup_full','backup_incremental','backup_binlog','snapshot_create','snapshot_restore','snapshot_prune','delete')),
+  payload_json TEXT NOT NULL DEFAULT '{}',
+  priority INTEGER NOT NULL DEFAULT 0,
+  state TEXT NOT NULL DEFAULT 'queued' CHECK (state IN ('queued','running','succeeded','failed','retrying','dead','cancelled')),
+  attempts INTEGER NOT NULL DEFAULT 0,
+  max_attempts INTEGER NOT NULL DEFAULT 5,
+  last_error TEXT,
+  scheduled_at TEXT,
+  started_at TEXT,
+  completed_at TEXT,
+  created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ','now')),
+  updated_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ','now')),
+  idempotency_key TEXT NOT NULL UNIQUE
+);
+CREATE INDEX idx_cjobs_container_state ON container_jobs(container_id, state, scheduled_at);
+CREATE INDEX idx_cjobs_kind_state ON container_jobs(kind, state);
+
+-- 컨테이너 백업 설정(고객별)
+CREATE TABLE container_backup_configs (
+  container_id TEXT PRIMARY KEY REFERENCES containers(id) ON DELETE CASCADE,
+  full_schedule_cron TEXT NOT NULL DEFAULT '0 3 * * *',
+  incremental_schedule_cron TEXT NOT NULL DEFAULT '0 * * * *',
+  binlog_schedule_cron TEXT NOT NULL DEFAULT '*/5 * * * *',
+  retention_days INTEGER NOT NULL DEFAULT 30,
+  encryption_key_version INTEGER NOT NULL DEFAULT 1,
+  r2_bucket TEXT NOT NULL,
+  enabled INTEGER NOT NULL DEFAULT 1 CHECK (enabled IN (0,1)),
+  updated_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ','now'))
+);
+
+-- 컨테이너 스냅샷 설정
+CREATE TABLE container_snapshot_configs (
+  container_id TEXT PRIMARY KEY REFERENCES containers(id) ON DELETE CASCADE,
+  schedule_cron TEXT NOT NULL DEFAULT '0 */6 * * *',
+  max_snapshots INTEGER NOT NULL DEFAULT 10,
+  ttl_days INTEGER NOT NULL DEFAULT 30,
+  enabled INTEGER NOT NULL DEFAULT 1 CHECK (enabled IN (0,1)),
+  updated_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ','now'))
+);
+
+-- 컨테이너 암호화 키 회전 이력
+CREATE TABLE container_encryption_keys (
+  id TEXT PRIMARY KEY,
+  container_id TEXT NOT NULL REFERENCES containers(id) ON DELETE CASCADE,
+  key_version INTEGER NOT NULL,
+  key_material_b64 TEXT NOT NULL,
+  derived_from_version INTEGER,
+  created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ','now')),
+  retired_at TEXT,
+  UNIQUE (container_id, key_version)
+);
+CREATE INDEX idx_enc_keys_container ON container_encryption_keys(container_id, key_version);
+
+-- 복원 작업
+CREATE TABLE restore_jobs (
+  id TEXT PRIMARY KEY,
+  container_id TEXT NOT NULL REFERENCES containers(id) ON DELETE CASCADE,
+  source_type TEXT NOT NULL CHECK (source_type IN ('backup','snapshot')),
+  source_id TEXT NOT NULL,
+  target_image_id TEXT REFERENCES container_images(id),
+  status TEXT NOT NULL DEFAULT 'pending' CHECK (status IN ('pending','running','completed','failed','cancelled')),
+  progress_pct INTEGER NOT NULL DEFAULT 0,
+  chunks_total INTEGER NOT NULL DEFAULT 0,
+  chunks_restored INTEGER NOT NULL DEFAULT 0,
+  error TEXT,
+  started_at TEXT,
+  completed_at TEXT,
+  created_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ','now')),
+  idempotency_key TEXT NOT NULL UNIQUE
+);
+CREATE INDEX idx_restore_jobs_container ON restore_jobs(container_id, created_at);
+
+-- 컨테이너 배치 점수 계산용 호스트 메트릭(주기적 수집)
+CREATE TABLE host_metrics (
+  id INTEGER PRIMARY KEY AUTOINCREMENT,
+  host_id TEXT NOT NULL,
+  ts TEXT NOT NULL,
+  free_mem_mib INTEGER NOT NULL,
+  free_vcpu REAL NOT NULL,
+  cpu_load REAL NOT NULL,
+  queue_depth INTEGER NOT NULL DEFAULT 0,
+  error_rate REAL NOT NULL DEFAULT 0,
+  restarts_7d INTEGER NOT NULL DEFAULT 0,
+  est_cost_per_hour_micro INTEGER NOT NULL,
+  latency_ms INTEGER NOT NULL DEFAULT 0,
+  healthy INTEGER NOT NULL DEFAULT 1 CHECK (healthy IN (0,1)),
+  supports_types_json TEXT NOT NULL DEFAULT '[]'
+);
+CREATE INDEX idx_host_metrics_ts ON host_metrics(host_id, ts);
+
+-- 기본 컨테이너 이미지 시드
+INSERT INTO container_images (id, docker_image, instance_type, vcpu, memory_mib, disk_gb, entrypoint, scheduling_policy, supports_snapshot, is_default) VALUES
+  ('img-ccs-lite', 'cloudpress/ccs-lite:latest', 'lite', 0.0625, 256, 2, '/entrypoint.sh', 'default', 0, 1),
+  ('img-ccs-basic', 'cloudpress/ccs-basic:latest', 'basic', 0.25, 1024, 4, '/entrypoint.sh', 'default', 0, 1),
+  ('img-ccs-standard1', 'cloudpress/ccs-standard:latest', 'standard-1', 0.5, 4096, 8, '/entrypoint.sh', 'durable_object', 1, 1),
+  ('img-ccs-standard2', 'cloudpress/ccs-standard:latest', 'standard-2', 1, 6144, 12, '/entrypoint.sh', 'durable_object', 1, 1),
+  ('img-ccs-standard3', 'cloudpress/ccs-standard:latest', 'standard-3', 2, 8192, 16, '/entrypoint.sh', 'durable_object', 1, 1),
+  ('img-ccs-standard4', 'cloudpress/ccs-standard:latest', 'standard-4', 4, 12288, 20, '/entrypoint.sh', 'durable_object', 1, 1),
+  ('img-cloudb-mariadb', 'cloudpress/cloudb-mariadb:latest', 'basic', 0.25, 1024, 4, '/entrypoint-mariadb.sh', 'durable_object', 1, 1),
+  ('img-cloudb-mysql', 'cloudpress/cloudb-mysql:latest', 'basic', 0.25, 1024, 4, '/entrypoint-mysql.sh', 'durable_object', 1, 1),
+  ('img-wp-starter', 'cloudpress/wp-starter:latest', 'basic', 0.25, 1024, 4, '/entrypoint-wp.sh', 'durable_object', 1, 1),
+  ('img-wp-pro', 'cloudpress/wp-pro:latest', 'standard-1', 0.5, 4096, 8, '/entrypoint-wp.sh', 'durable_object', 1, 1),
+  ('img-wp-business', 'cloudpress/wp-business:latest', 'standard-2', 1, 6144, 12, '/entrypoint-wp.sh', 'durable_object', 1, 1),
+  ('img-wp-scale', 'cloudpress/wp-scale:latest', 'standard-3', 2, 8192, 16, '/entrypoint-wp.sh', 'durable_object', 1, 1);
diff --git a/src/lib/backupPipeline.ts b/src/lib/backupPipeline.ts
new file mode 100644
index 0000000..e188fb5
--- /dev/null
+++ b/src/lib/backupPipeline.ts
@@ -0,0 +1,70 @@
+import { type D1Like, newId, nowIso } from "./db";
+import { b64urlDecode, b64urlEncode } from "./crypto";
+
+const CHUNK_SIZE = 5 * 1024 * 1024;
+const IV_LENGTH = 12;
+
+export interface R2Bucket {
+  put(key: string, value: any, options?: any): Promise<any>;
+  get(key: string): Promise<any>;
+  delete(keys: string | string[]): Promise<void>;
+}
+
+export interface BackupPipeline {
+  runBackup(jobId: string, containerId: string, databaseId: string | null, kind: "full" | "incremental" | "binlog", r2Prefix: string, encryptionKeyId: string, interceptStream: ReadableStream, totalBytes: number): Promise<void>;
+  pruneBackups(containerId: string, encryptionKeyId: string, retentionDays: number, nowMs: number): Promise<{ freedBytes: number; deletedChunks: number }>;
+}
+
+export async function deriveKey(masterKeyB64: string, saltB64: string, info: string): Promise<CryptoKey> {
+  const masterKey = await crypto.subtle.importKey("raw", b64urlDecode(masterKeyB64), { name: "HKDF" }, false, ["deriveKey"]);
+  return crypto.subtle.deriveKey(
+    { name: "HKDF", hash: "SHA-256", salt: b64urlDecode(saltB64), info: new TextEncoder().encode(info) },
+    masterKey,
+    { name: "AES-GCM", length: 256 },
+    true,
+    ["encrypt", "decrypt"]
+  );
+}
+
+export class LiveBackupPipeline implements BackupPipeline {
+  constructor(private db: D1Like, private r2: R2Bucket, private getMasterKey: (encryptionKeyId: string) => Promise<string | null>) {}
+
+  async runBackup(jobId: string, containerId: string, databaseId: string | null, kind: string, r2Prefix: string, encryptionKeyId: string, interceptStream: ReadableStream, totalBytes: number): Promise<void> {
+    await this.db.prepare("UPDATE backup_jobs SET status='running', started_at=? WHERE id=?").bind(nowIso(), jobId).run();
+    const masterKeyB64 = await this.getMasterKey(encryptionKeyId);
+    if (!masterKeyB64) throw new Error("encryption_key_not_found");
+    
+    let chunkIndex = 0;
+    const reader = interceptStream.getReader();
+    while (true) {
+      const { done, value } = await reader.read();
+      if (done) break;
+      const chunk = value as Uint8Array;
+      const salt = crypto.getRandomValues(new Uint8Array(16));
+      const derivedKey = await deriveKey(masterKeyB64, b64urlEncode(salt), `backup-chunk-${jobId}-${chunkIndex}`);
+      const iv = crypto.getRandomValues(new Uint8Array(IV_LENGTH));
+      const encrypted = await crypto.subtle.encrypt({ name: "AES-GCM", iv: iv }, derivedKey, chunk);
+      const r2Key = `${r2Prefix}chunk-${chunkIndex}.enc`;
+      await this.r2.put(r2Key, new Uint8Array(encrypted), { customMetadata: { salt: b64urlEncode(salt), iv: b64urlEncode(iv) } });
+      await this.db.prepare("INSERT INTO backup_chunks (id, backup_job_id, chunk_index, r2_key, size_bytes, sha256, uploaded_at) VALUES (?, ?, ?, ?, ?, ?, ?)").bind(newId("bchk"), jobId, chunkIndex, r2Key, encrypted.byteLength, "", nowIso()).run();
+      chunkIndex++;
+    }
+    await this.db.prepare("UPDATE backup_jobs SET status='completed', completed_at=? WHERE id=?").bind(nowIso(), jobId).run();
+  }
+
+  async pruneBackups(containerId: string, encryptionKeyId: string, retentionDays: number, nowMs: number): Promise<{ freedBytes: number; deletedChunks: number }> {
+    return { freedBytes: 0, deletedChunks: 0 };
+  }
+}
+
+export function createBackupPipeline(env: { mode: "mock" | "live"; db: D1Like; r2Bucket?: R2Bucket }): BackupPipeline {
+  if (env.mode === "mock") {
+    return { async runBackup() {}, async pruneBackups() { return { freedBytes: 0, deletedChunks: 0 }; } };
+  }
+  if (!env.r2Bucket) throw new Error("R2Bucket required");
+  const getMasterKey = async (encryptionKeyId: string) => {
+    const row = await env.db.prepare("SELECT key_material_b64 FROM container_encryption_keys WHERE id = ?").bind(encryptionKeyId).first<{ key_material_b64: string }>();
+    return row?.key_material_b64 ?? null;
+  };
+  return new LiveBackupPipeline(env.db, env.r2Bucket, getMasterKey);
+}
diff --git a/src/lib/containerManager.ts b/src/lib/containerManager.ts
new file mode 100644
index 0000000..8d09482
--- /dev/null
+++ b/src/lib/containerManager.ts
@@ -0,0 +1,446 @@
+import { type D1Like, newId, nowIso } from "./db";
+import { OFFICIAL_INSTANCE_TYPES, type InstanceType, type ProductKind } from "./catalog";
+import { type Provisioner } from "./jobs";
+
+/** 컨테이너 매니저 포트(Worker → Containers API) */
+export interface ContainerManager {
+  /** 컨테이너 생성·시작(durable_object 정책: ctx.container.start) */
+  provision(params: ProvisionParams): Promise<ProvisionResult>;
+  /** 컨테이너 중지(절전/정지) */
+  suspend(containerId: string): Promise<void>;
+  /** 컨테이너 재시작(절전 해제) */
+  resume(containerId: string): Promise<void>;
+  /** 컨테이너 크기 변경(인스턴스 타입 변경) */
+  resize(containerId: string, newInstanceType: InstanceType): Promise<void>;
+  /** 컨테이너 삭제(데이터 보존 옵션) */
+  delete(containerId: string, keepData: boolean): Promise<void>;
+  /** 스냅샷 생성 */
+  createSnapshot(containerId: string): Promise<SnapshotResult>;
+  /** 스냅샷 복원 */
+  restoreSnapshot(containerId: string, snapshotHandle: string, targetImageId?: string): Promise<void>;
+  /** 백업 트리거(전체/증분/binlog) */
+  triggerBackup(containerId: string, kind: "full" | "incremental" | "binlog"): Promise<string>;
+  /** 컨테이너 상태 조회 */
+  getStatus(containerId: string): Promise<ContainerStatus>;
+  /** 배치 후보 호스트 메트릭 수집 */
+  collectHostMetrics(): Promise<HostMetric[]>;
+}
+
+export interface ProvisionParams {
+  containerId: string;
+  customerId: string;
+  subscriptionId: string;
+  productKind: ProductKind;
+  instanceType: InstanceType;
+  targetVcpu: number;
+  actualVcpu: number;
+  imageId: string;
+  schedulingPolicy: "default" | "durable_object";
+  enableInternet: boolean;
+  interceptTargets: { host: string; port: number }[];  // 백업용 내부 엔드포인트
+  env: Record<string, string>;
+  labels: Record<string, string>;
+  sleepPolicy: "idle" | "never";
+}
+
+export interface ProvisionResult {
+  cfInstanceId: string;
+  ip: string;
+  port: number;
+  durableObjectId?: string;
+}
+
+export interface SnapshotResult {
+  snapshotHandle: string;
+  sizeBytes: number;
+  expiresAt: string;
+}
+
+export interface ContainerStatus {
+  state: "provisioning" | "running" | "sleeping" | "stopped" | "failed" | "deleting" | "deleted";
+  ip?: string;
+  port?: number;
+  lastHeartbeatAt?: string;
+  cfInstanceId?: string;
+}
+
+export interface HostMetric {
+  hostId: string;
+  freeMemMiB: number;
+  freeVcpu: number;
+  cpuLoad: number;
+  queueDepth: number;
+  errorRate: number;
+  restarts7d: number;
+  estCostPerHourMicro: number;
+  latencyMs: number;
+  healthy: boolean;
+  supportsTypes: InstanceType[];
+}
+
+/** Cloudflare Containers API 클라이언트(Durable Object 기반) */
+export interface CfContainersClient {
+  /** durable_object 정책: 컨테이너 시작 */
+  startContainer(params: {
+    containerId: string;
+    image: string;
+    instanceType: InstanceType;
+    enableInternet: boolean;
+    entrypoint: string;
+    env: Record<string, string>;
+    labels: Record<string, string>;
+    interceptOutboundHttp: { targets: { host: string; port: number }[] };
+  }): Promise<{ instanceId: string; ip: string; port: number; durableObjectId: string }>;
+  
+  /** default 정책: 컨테이너 시작(Wrangler 설정 기반) */
+  startDefaultContainer(params: {
+    containerId: string;
+    image: string;
+  }): Promise<{ instanceId: string; ip: string; port: number }>;
+  
+  stopContainer(instanceId: string): Promise<void>;
+  deleteContainer(instanceId: string): Promise<void>;
+  createSnapshot(instanceId: string): Promise<{ handle: string; sizeBytes: number; expiresAt: string }>;
+  restoreSnapshot(instanceId: string, snapshotHandle: string, targetImage?: string): Promise<void>;
+  getContainerStatus(instanceId: string): Promise<ContainerStatus>;
+  listHostMetrics(): Promise<HostMetric[]>;
+}
+
+/** 모의 구현(개발/테스트용) */
+export class MockContainerManager implements ContainerManager {
+  private instances = new Map<string, { 
+    cfInstanceId: string; 
+    ip: string; 
+    port: number; 
+    state: ContainerStatus["state"]; 
+    durableObjectId?: string;
+    imageId: string;
+    schedulingPolicy: "default" | "durable_object";
+    interceptTargets: { host: string; port: number }[];
+  }>();
+  
+  private snapshots = new Map<string, { handle: string; sizeBytes: number; expiresAt: string }[]>();
+  private backupJobs = new Map<string, { id: string; status: string }[]>();
+  
+  async provision(params: ProvisionParams): Promise<ProvisionResult> {
+    const cfInstanceId = \cf_\_\\;
+    const ip = \10.\.\.\\;
+    const port = 8080 + Math.floor(Math.random() * 1000);
+    const durableObjectId = params.schedulingPolicy === "durable_object" ? \do_\\ : undefined;
+    
+    this.instances.set(params.containerId, {
+      cfInstanceId,
+      ip,
+      port,
+      state: "running",
+      durableObjectId,
+      imageId: params.imageId,
+      schedulingPolicy: params.schedulingPolicy,
+      interceptTargets: params.interceptTargets,
+    });
+    
+    return { cfInstanceId, ip, port, durableObjectId };
+  }
+  
+  async suspend(containerId: string): Promise<void> {
+    const inst = this.instances.get(containerId);
+    if (inst) inst.state = "sleeping";
+  }
+  
+  async resume(containerId: string): Promise<void> {
+    const inst = this.instances.get(containerId);
+    if (inst) inst.state = "running";
+  }
+  
+  async resize(containerId: string, newInstanceType: InstanceType): Promise<void> {
+    const inst = this.instances.get(containerId);
+    if (inst) {
+      inst.state = "running"; // 모의: 즉시 적용
+    }
+  }
+  
+  async delete(containerId: string, keepData: boolean): Promise<void> {
+    const inst = this.instances.get(containerId);
+    if (inst) {
+      inst.state = keepData ? "stopped" : "deleted";
+      if (!keepData) this.instances.delete(containerId);
+    }
+  }
+  
+  async createSnapshot(containerId: string): Promise<SnapshotResult> {
+    const inst = this.instances.get(containerId);
+    if (!inst) throw new Error("container_not_found");
+    if (inst.schedulingPolicy !== "durable_object") throw new Error("snapshots_not_supported");
+    
+    const handle = \snap_\_\\;
+    const sizeBytes = Math.floor(Math.random() * 1024 * 1024 * 500) + 10 * 1024 * 1024;
+    const expiresAt = new Date(Date.now() + 30 * 24 * 60 * 60 * 1000).toISOString();
+    
+    const arr = this.snapshots.get(containerId) ?? [];
+    arr.push({ handle, sizeBytes, expiresAt });
+    this.snapshots.set(containerId, arr);
+    
+    return { snapshotHandle: handle, sizeBytes, expiresAt };
+  }
+  
+  async restoreSnapshot(containerId: string, snapshotHandle: string, targetImageId?: string): Promise<void> {
+    const inst = this.instances.get(containerId);
+    if (!inst) throw new Error("container_not_found");
+    inst.state = "running";
+  }
+  
+  async triggerBackup(containerId: string, kind: "full" | "incremental" | "binlog"): Promise<string> {
+    const jobId = \ackup_\_\_\\;
+    const arr = this.backupJobs.get(containerId) ?? [];
+    arr.push({ id: jobId, status: "completed" });
+    this.backupJobs.set(containerId, arr);
+    return jobId;
+  }
+  
+  async getStatus(containerId: string): Promise<ContainerStatus> {
+    const inst = this.instances.get(containerId);
+    if (!inst) return { state: "deleted" };
+    return { state: inst.state, ip: inst.ip, port: inst.port, lastHeartbeatAt: new Date().toISOString(), cfInstanceId: inst.cfInstanceId };
+  }
+  
+  async collectHostMetrics(): Promise<HostMetric[]> {
+    return [
+      {
