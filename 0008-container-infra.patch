+        freeMemMiB: 32768,
+        freeVcpu: 8,
+        cpuLoad: 0.3,
+        queueDepth: 5,
+        errorRate: 0.001,
+        restarts7d: 0,
+        estCostPerHourMicro: 50000,
+        latencyMs: 2,
+        healthy: true,
+        supportsTypes: ["lite", "basic", "standard-1", "standard-2", "standard-3", "standard-4"],
+      },
+    ];
+  }
