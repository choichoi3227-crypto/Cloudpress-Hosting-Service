{
  "name": "cloudpress-hosting-service",
  "main": "src/worker.ts",
  "build": {
    "command": "cd frontend && npm install && npm run build",
    "cwd": "."
  },
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  "vars": {
    "APP_ORIGIN": "https://cloud-press.co.kr",
    "CLOUDPRESS_MODE": "live"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudpress-production",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "JOBS",
        "queue": "cloudpress-jobs-production"
      }
    ],
    "consumers": [
      {
        "queue": "cloudpress-jobs-production",
        "max_batch_size": 10,
        "max_batch_timeout": 5
      }
    ]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
