{
  "name": "cloudpress-hosting-service",
  "main": "src/worker.ts",
  "build": {
    "command": "cd frontend && npm install && npm run build",
    "cwd": "."
  },
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // /api 와 /services/* 는 항상 Worker 가 먼저 처리한다(서비스 상세 라우팅). 없는 정적 파일(.js 등)은 HTML 이 아니라 404 를 반환해야 한다.
    "run_worker_first": ["/api/*", "/services/*"]
  },
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  "vars": {
    "APP_ORIGIN": "https://cloud-press.co.kr",
    "CLOUDPRESS_MODE": "live"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudpress-dev",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "JOBS",
        "queue": "cloudpress-jobs-production"
      }
    ],
    "consumers": [
      {
        "queue": "cloudpress-jobs-production",
        "max_batch_size": 10,
        "max_batch_timeout": 5
      }
    ]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
